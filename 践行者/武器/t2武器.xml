    <AITarget sightrange="3200" soundrange="2400" fadeouttime="7" />

    <Quality>
      <QualityStat stattype="FirepowerMultiplier" value="0.1" />
    </Quality>

    <SkillRequirementHint identifier="weapons" level="45" />
