    <Holdable slots="RightHand+LeftHand" holdpos="0,-50" handle1="-10,0" handle2="10,0" aimable="false" />

    <Projectile characterusable="false" hitscan="true" maxtargetstohit="1" removeonhit="true" damagedoors="true">
      <ParticleEmitter
        particle="aic_electricarc_storm"
        particleamount="1"
        velocitymin="0"
        velocitymax="0"
        scalemultiplier="0.00055,0.75" />
      <ParticleEmitter particle="FlareBubbles" emitacrossrayinterval="50" />

      <Attack structuredamage="8" targetforce="20" itemdamage="45" severlimbsprobability="0" penetration="0.8">
        <Affliction identifier="electricshock" strength="150" />
        <Affliction identifier="emp" strength="150" />
        <Affliction identifier="burn" strength="160" />
        <Affliction identifier="aic_heat_buildup" strength="60" />
      </Attack>

      <StatusEffect type="OnImpact" target="UseTarget">
        <ParticleEmitter particle="muzzleflashnucleargun" anglemin="0" anglemax="360" particleamount="10" velocitymin="0" scalemin="0.8" scalemax="1.0" scalemultiplier="0.75,0.75" colormultiplier="205,145,255,255" />
        <ParticleEmitter particle="ElectricShock" drawontop="true" distancemin="5" distancemax="35" particleamount="9" scalemin="0.2" scalemax="0.4" colormultiplier="205,145,255,255" />
        <ParticleEmitter particle="FlareBubbles" particleamount="3" anglemin="0" anglemax="360" velocitymin="0" velocitymax="50" />
      </StatusEffect>

      <StatusEffect type="OnImpact" target="UseTarget">
        <Conditional entitytype="eq Structure" />
        <Conditional hastag="eq door" />
        <ParticleEmitter particle="spark" copyentityangle="true" anglemin="-10" anglemax="10" particleamount="5" velocitymin="-10" velocitymax="-200" scalemin="0.5" scalemax="1" colormultiplier="185,115,255,255" />
      </StatusEffect>

      <StatusEffect type="OnNotContained" target="This" stackable="false" delay="1">
        <Remove />
      </StatusEffect>
    </Projectile>
  </Item>
</Items>
