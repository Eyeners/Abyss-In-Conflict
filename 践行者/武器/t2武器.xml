    name="神谕磁暴电弧"
    identifier="aic_practitioner_oracle_arc_bolt"
    category="Weapon"
    interactthroughwalls="true"
    tags="smallitem,aic_practitioner_energy_bolt"
    impactsoundtag="impact_metal_light"
    hideinmenus="true"
    description="沿电磁孤子形成的导流通路传导的高强度电弧，用于向目标释放磁暴电弧。"
    scale="0.5">

