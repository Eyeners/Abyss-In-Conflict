    <InventoryIcon
      texture="%ModDir%/材料/贴图/材料.png"
      sourcerect="0,59,20,69"
      origin="0.5,0.5" />

    <Sprite
      texture="%ModDir%/材料/贴图/材料.png"
      sourcerect="0,59,20,69"
      depth="0.56"
      origin="0.5,0.5" />

    <Body radius="6" width="21" height="71" density="20" />

    <ItemContainer
      hideitems="true"
      capacity="1"
      itemrotation="90"
      drawinventory="false"
      canbeselected="false"
      spawnwithid="aic_practitioner_oracle_arc_bolt"
      removecontaineditemsondeconstruct="true"
      showconditionincontainedstateindicator="true"
      containedstateindicatorstyle="bullet">

      <Containable items="aic_practitioner_oracle_arc_bolt" />

      <StatusEffect type="OnUse" target="This" condition="-20" disabledeltatime="true">
