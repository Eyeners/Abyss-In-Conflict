    <TriggerComponent triggeredby="Human,Creature" ignoredead="true" force="0" width="260" height="280" bodyoffset="0,-140">
      <StatusEffect type="OnActive" target="This" condition="0" setvalue="true" disabledeltatime="true" conditionalcomparison="And">
        <Conditional condition="lte 99" />
        <Conditional isactive="true" targetitemcomponent="Projectile" />
        <Conditional triggeractive="true" targetitemcomponent="TriggerComponent" />
        <Conditional condition="gt 0" />
      </StatusEffect>
    </TriggerComponent>
