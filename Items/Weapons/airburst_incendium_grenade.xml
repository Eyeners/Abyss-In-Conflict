<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Item name="空爆燃烧弹" identifier="aic_airburst_incendium_grenade" category="Weapon" maxstacksize="32" maxstacksizecharacterinventory="8" interactthroughwalls="true" cargocontaineridentifier="metalcrate" tags="smallitem,grenade" scale="0.5" impactsoundtag="impact_metal_heavy">
