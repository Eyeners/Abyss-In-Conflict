      <Sound file="Content/Items/Weapons/FragGrenade40mmShot2.ogg" type="OnImpact" range="3000" />
      <!-- Native proximity sensors cannot exclude the shooter, so arm only after the round has cleared the muzzle. -->
      <StatusEffect type="OnUse" target="This" condition="99" setvalue="true" delay="0.2" disabledeltatime="true" checkconditionalalways="true">
        <Conditional condition="gt 99" />
      </StatusEffect>
      <StatusEffect type="OnImpact" target="This" condition="0" setvalue="true" disabledeltatime="true" conditionalcomparison="And">
        <Conditional condition="lte 99" />
