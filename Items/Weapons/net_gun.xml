<?xml version="1.0" encoding="utf-8"?>
<Items>
  <Item
    name=""
    identifier="aic_net_gun"
    category="Weapon"
    cargocontaineridentifier="metalcrate"
    tags="smallitem,weapon,gun,stunner,provocativetohumanai,mountableweapon,aic_net_gun"
    scale="0.16"
    impactsoundtag="impact_metal_light">

    <Sprite texture="%ModDir%/Items/Weapons/牵引光束.png" sourcerect="0,0,600,280" depth="0.55" origin="0.5,0.5" />
    <Body width="190" height="42" density="25" />

    <Holdable slots="Any,RightHand+LeftHand" controlpose="true" aimpos="60,0" handle1="-97,-34" handle2="57,-20" msg="ItemMsgPickUpSelect" />

    <RangedWeapon reload="3" launchimpulse="6" barrelpos="50,0" spread="0" unskilledspread="25" combatpriority="80" drawhudwhenequipped="true" crosshairscale="0.2">
      <Crosshair texture="Content/Items/Weapons/Crosshairs.png" sourcerect="0,256,256,256" />
      <CrosshairPointer texture="Content/Items/Weapons/Crosshairs.png" sourcerect="256,256,256,256" />
      <Sound file="Content/Items/Weapons/HarpoonGun1.ogg" type="OnUse" range="1000" />
      <StatusEffect type="OnUse" target="This">
        <Explosion range="150" force="5" shockwave="false" smoke="false" flames="false" flash="false" sparks="false" underwaterbubble="false" camerashake="6" />
      </StatusEffect>
      <RequiredItems items="aic_net_round" type="Contained" msg="ItemMsgAmmoRequired" />
    </RangedWeapon>

    <ItemContainer capacity="1" maxstacksize="6" hideitems="true" containedstateindicatorstyle="bullet">
      <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
      <Containable items="aic_net_round" />
    </ItemContainer>

    <aitarget sightrange="2000" soundrange="3000" fadeouttime="5" />
    <Quality>
      <QualityStat stattype="FirepowerMultiplier" value="0.1" />
    </Quality>
  </Item>

  <Item
    name=""
    identifier="aic_net_round"
    category="Weapon"
    maxstacksize="32"
    maxstacksizecharacterinventory="6"
    interactthroughwalls="true"
    cargocontaineridentifier="metalcrate"
    tags="smallitem,aic_net_round,handheldammo"
    scale="0.5"
    impactsoundtag="impact_soft">

    <InventoryIcon texture="%ModDir%/材料/贴图/材料.png" sourcerect="5,150,37,51" origin="0.5,0.5" />
    <Sprite texture="%ModDir%/Items/Net1.png" sourcerect="0,0,240,240" depth="0.55" origin="0.5,0.5" color="72,76,80,255" />
    <Body width="160" height="10" density="30" />
    <Pickable slots="Any" msg="ItemMsgPickUpSelect" />

    <Projectile
      characterusable="false"
      launchimpulse="10"
      maxtargetstohit="1"
      sticktocharacters="true"
      sticktoitems="false"
      sticktodeflective="false"
      sticktostructures="false"
      sticktodoors="false">

      <Attack structuredamage="0" itemdamage="0" targetforce="20" severlimbsprobability="0" />

      <StatusEffect type="OnImpact" target="UseTarget" setvalue="true" duration="40" comparison="And">
        <Conditional IsHuman="true" />
        <Affliction identifier="aic_net_entanglement" />
      </StatusEffect>
      <StatusEffect type="OnImpact" target="UseTarget" lockhands="true" setvalue="true" duration="10" comparison="And">
        <Conditional IsHuman="true" />
        <Affliction identifier="stun" />
      </StatusEffect>

      <!-- One complete vanilla stun-gun discharge: the initial pulse and its delayed follow-up. -->
      <StatusEffect type="OnImpact" target="UseTarget" delay="0.5" disabledeltatime="true">
        <Conditional entitytype="eq Character" />
        <ParticleEmitter particle="ElectricShock" distancemin="5" distancemax="20" particleamount="3" scalemin="0.07" scalemax="0.1" />
        <Affliction identifier="electricshock" strength="80" />
        <Affliction identifier="emp" strength="80" />
      </StatusEffect>
      <StatusEffect type="OnImpact" target="UseTarget" delay="2.5" disabledeltatime="true">
        <Conditional entitytype="eq Character" />
        <Affliction identifier="electricshock" strength="35" />
        <Affliction identifier="emp" strength="35" />
      </StatusEffect>
      <StatusEffect type="OnImpact" target="This" delay="0.5" disabledeltatime="true">
        <Sound file="Content/Items/Weapons/TaserHit1.ogg" type="OnUse" range="500" selectionmode="Random" />
        <Sound file="Content/Items/Weapons/TaserHit2.ogg" type="OnUse" range="500" />
        <ParticleEmitter particle="ElectricShock" distancemin="5" distancemax="20" particleamount="3" scalemin="0.07" scalemax="0.1" />
      </StatusEffect>

      <StatusEffect type="OnImpact" target="This" spritecolor="0,0,0,0" setvalue="true" disabledeltatime="true" />
      <StatusEffect type="OnImpact" target="This" delay="10" disabledeltatime="true">
        <Remove />
      </StatusEffect>
    </Projectile>
  </Item>
</Items>
