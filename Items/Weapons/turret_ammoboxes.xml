      <StatusEffect type="OnUse" target="This" disabledeltatime="true">
        <SpawnItem identifiers="aic_coilgunbolt_tungsten_piercing" spawnposition="ThisInventory" />
        <Conditional condition="gt 0" />
      </StatusEffect>
      <Containable items="aic_coilgunbolt_tungsten_piercing" />
    </ItemContainer>
